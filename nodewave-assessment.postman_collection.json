		{
			"name": "Scenarios (brief)",
			"description": "Each request signs in as the right role in its pre-request script, so the folder can run top to bottom in the Collection Runner.",
			"item": [
				{
					"name": "A1 \u00b7 Frontend cannot start a blocked task \u2192 422",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/tasks/{{blockedTaskId}}/status",
							"host": ["{{baseUrl}}"],
							"path": ["tasks", "{{blockedTaskId}}", "status"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"version\": 1\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Seed: Frontend slicing depends on UI Design (done) and Backend API (in progress). A 409 means the version moved \u2014 rerun after 'Get task'."
					},
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const base = pm.environment.get(\"baseUrl\");",
									"pm.sendRequest({",
									"  url: base + \"/auth/login\",",
									"  method: \"POST\",",
									"  header: { \"Content-Type\": \"application/json\" },",
									"  body: { mode: \"raw\", raw: JSON.stringify({ email: pm.environment.get(\"frontendEmail\"), password: pm.environment.get(\"seedPassword\") }) }",
									"}, (err, res) => { if (!err) pm.collectionVariables.set(\"token\", res.json().data.token); });"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"rejected\", () => pm.expect(pm.response.code).to.be.oneOf([409, 422]));",
									"const err = pm.response.json().error;",
									"if (pm.response.code === 422) pm.test(\"TASK_BLOCKED with pending prerequisites\", () => {",
									"  pm.expect(err.code).to.eql(\"TASK_BLOCKED\");",
									"  pm.expect(err.details.pendingPrerequisites).to.be.an(\"array\").that.is.not.empty;",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "A2 \u00b7 Blocked task detail explains why",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/tasks/{{blockedTaskId}}",
							"host": ["{{baseUrl}}"],
							"path": ["tasks", "{{blockedTaskId}}"]
						}
					},
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const base = pm.environment.get(\"baseUrl\");",
									"pm.sendRequest({",
									"  url: base + \"/auth/login\",",
									"  method: \"POST\",",
									"  header: { \"Content-Type\": \"application/json\" },",
									"  body: { mode: \"raw\", raw: JSON.stringify({ email: pm.environment.get(\"frontendEmail\"), password: pm.environment.get(\"seedPassword\") }) }",
									"}, (err, res) => { if (!err) pm.collectionVariables.set(\"token\", res.json().data.token); });"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
									"const t = pm.response.json().data;",
									"pm.test(\"blockedBy lists pending prerequisites\", () => pm.expect(t.blockedBy).to.be.an(\"array\"));",
									"pm.test(\"availableTransitions explain denials\", () => pm.expect(t.availableTransitions.every(x => x.allowed || x.reason)).to.be.true);"
								]
							}
						}
					]
				},
				{
					"name": "B \u00b7 PM cannot mark IN_PROGRESS task as done \u2192 403",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/tasks/{{inProgressTaskId}}/status",
							"host": ["{{baseUrl}}"],
							"path": ["tasks", "{{inProgressTaskId}}", "status"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"DONE\",\n  \"version\": 1\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Only the assignee (executor) may complete work."
					},
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const base = pm.environment.get(\"baseUrl\");",
									"pm.sendRequest({",
									"  url: base + \"/auth/login\",",
									"  method: \"POST\",",
									"  header: { \"Content-Type\": \"application/json\" },",
									"  body: { mode: \"raw\", raw: JSON.stringify({ email: pm.environment.get(\"pmEmail\"), password: pm.environment.get(\"seedPassword\") }) }",
									"}, (err, res) => { if (!err) pm.collectionVariables.set(\"token\", res.json().data.token); });"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"rejected\", () => pm.expect(pm.response.code).to.be.oneOf([403, 409, 422]));",
									"if (pm.response.code === 403) pm.test(\"NOT_EXECUTOR\", () => pm.expect(pm.response.json().error.code).to.eql(\"NOT_EXECUTOR\"));"
								]
							}
						}
					]
				},
