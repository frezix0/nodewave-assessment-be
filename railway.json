{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bunx prisma generate"
  },
  "deploy": {
    "startCommand": "bun run start",
    "preDeployCommand": ["bunx prisma migrate deploy"],
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}