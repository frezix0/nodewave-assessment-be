{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "RAILPACK"
	},
	"deploy": {
		"startCommand": "bun run start",
        "preDeployCommand": ["bunx prisma migrate deploy && bun prisma/seed.ts"],
		"healthcheckPath": "/health",
		"restartPolicyType": "ON_FAILURE"
	}
}
